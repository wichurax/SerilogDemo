###############################################################################
# SerilogDemo E-Commerce API - HTTP Request Examples
# 
# This file contains all API endpoints for the e-commerce demo.
# Use VS Code REST Client extension or JetBrains HTTP Client to run these.
#
# Flow: Browse Items → Add to Cart → Select Delivery/Payment → Place Order
###############################################################################

# @baseUrl = http://localhost:5299
@baseUrl = http://localhost:8080
@userId = demo-user-123

###############################################################################
# ITEMS CATALOG
###############################################################################

### Get all items
GET {{baseUrl}}/api/items
Accept: application/json

### Get item by ID (Wireless Bluetooth Headphones)
GET {{baseUrl}}/api/items/00000000-0000-0000-0000-000000000001
Accept: application/json

### Get all categories
GET {{baseUrl}}/api/items/categories
Accept: application/json

### Get items by category
GET {{baseUrl}}/api/items/categories/Electronics
Accept: application/json

### Get items by category - Furniture
GET {{baseUrl}}/api/items/categories/Furniture
Accept: application/json

### Get items by category - Office
GET {{baseUrl}}/api/items/categories/Office
Accept: application/json

### Search items by keyword
GET {{baseUrl}}/api/items?search=monitor
Accept: application/json

###############################################################################
# SHOPPING CART
# All cart operations require X-User-Id header
###############################################################################

### Get current cart (empty initially)
GET {{baseUrl}}/api/cart
Accept: application/json
X-User-Id: {{userId}}

### Add item to cart - Wireless Headphones (qty: 2)
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{userId}}

{
    "itemId": "00000000-0000-0000-0000-000000000001",
    "quantity": 2
}

### Add another item - Mechanical Keyboard (qty: 1)
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{userId}}

{
    "itemId": "00000000-0000-0000-0000-000000000002",
    "quantity": 1
}

### Add item - USB-C Hub (qty: 1)
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{userId}}

{
    "itemId": "00000000-0000-0000-0000-000000000004",
    "quantity": 1
}

### View cart with items
GET {{baseUrl}}/api/cart
Accept: application/json
X-User-Id: {{userId}}

### Update item quantity in cart (change headphones to qty: 1)
PUT {{baseUrl}}/api/cart/items/00000000-0000-0000-0000-000000000001
Content-Type: application/json
X-User-Id: {{userId}}

{
    "quantity": 1
}

### Remove item from cart
DELETE {{baseUrl}}/api/cart/items/00000000-0000-0000-0000-000000000004
X-User-Id: {{userId}}

### Clear entire cart
DELETE {{baseUrl}}/api/cart
X-User-Id: {{userId}}

###############################################################################
# DELIVERY OPTIONS
###############################################################################

### Get all delivery options
GET {{baseUrl}}/api/deliveryoptions
Accept: application/json

### Filter by courier - DPD
GET {{baseUrl}}/api/deliveryoptions?courier=DPD
Accept: application/json

### Filter by courier - DHL
GET {{baseUrl}}/api/deliveryoptions?courier=DHL
Accept: application/json

### Filter by courier - InPost
GET {{baseUrl}}/api/deliveryoptions?courier=InPost
Accept: application/json

### Get delivery option by ID (DPD Standard)
GET {{baseUrl}}/api/deliveryoptions/00000000-0000-0000-0001-000000000001
Accept: application/json

###############################################################################
# PAYMENT OPTIONS
###############################################################################

### Get all payment options
GET {{baseUrl}}/api/paymentoptions
Accept: application/json

### Get payment option by ID (Credit Card)
GET {{baseUrl}}/api/paymentoptions/00000000-0000-0000-0002-000000000001
Accept: application/json

###############################################################################
# ORDERS
# Requires items in cart before placing an order
###############################################################################

### Step 1: Add items to cart first (run the cart POST requests above)

### Step 2: Place an order (DPD Standard + Credit Card)
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-User-Id: {{userId}}

{
    "deliveryOptionId": "00000000-0000-0000-0001-000000000001",
    "paymentOptionId": "00000000-0000-0000-0002-000000000001",
    "shippingAddress": {
        "street": "123 Main Street",
        "city": "New York",
        "postalCode": "10001",
        "country": "USA"
    }
}

### Get all orders for user
GET {{baseUrl}}/api/orders
Accept: application/json
X-User-Id: {{userId}}

### Get order by ID (replace with actual order ID from previous response)
GET {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000
Accept: application/json
X-User-Id: {{userId}}


###############################################################################
# HEALTH CHECK (for load balancer)
###############################################################################

### Health check endpoint
GET {{baseUrl}}/health
Accept: application/json


###############################################################################
# LOKI / GRAFANA LOG QUERIES
# Query structured logs directly from Loki API
# Useful for debugging and log analysis
###############################################################################

@lokiUrl = http://localhost:3100
@grafanaUrl = http://localhost:3001

### Get all logs from SerilogDemo app (last 1 hour)
GET {{lokiUrl}}/loki/api/v1/query_range?query={service_name="serilogdemo-api"}&start={{$timestamp -3600000}}&end={{$timestamp}}&limit=100
Accept: application/json

### Get logs for specific UserId
# Replace the userId value to search for different users
GET {{lokiUrl}}/loki/api/v1/query_range?query={service_name="serilogdemo-api"} |= `"UserId":"demo-user-123"`&limit=50
Accept: application/json

### Get logs for UserId using LogQL json parser (more precise)
GET {{lokiUrl}}/loki/api/v1/query_range?query={service_name="serilogdemo-api"} | json | UserId="demo-user-123"&limit=50
Accept: application/json

### Get all ERROR level logs
GET {{lokiUrl}}/loki/api/v1/query_range?query={service_name="serilogdemo-api"} |= `"Level":"Error"`&limit=100
Accept: application/json

### Get logs containing "order" (case insensitive)
GET {{lokiUrl}}/loki/api/v1/query_range?query={service_name="serilogdemo-api"} |~ `(?i)order`&limit=50
Accept: application/json

### Get available label names
GET {{lokiUrl}}/loki/api/v1/labels
Accept: application/json

### Get values for 'service_name' label
GET {{lokiUrl}}/loki/api/v1/label/service_name/values
Accept: application/json


###############################################################################
# COMPLETE SHOPPING FLOW - Run these in order
###############################################################################

### 1. Browse electronics
GET {{baseUrl}}/api/items/categories/Electronics
Accept: application/json

### 2. Add 4K Monitor 27" to cart
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{userId}}

{
    "itemId": "00000000-0000-0000-0000-000000000007",
    "quantity": 1
}

### 3. Add Mechanical Gaming Keyboard to cart
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{userId}}

{
    "itemId": "00000000-0000-0000-0000-000000000002",
    "quantity": 1
}

### 4. View cart
GET {{baseUrl}}/api/cart
Accept: application/json
X-User-Id: {{userId}}

### 5. Check delivery options
GET {{baseUrl}}/api/deliveryoptions
Accept: application/json

### 6. Check payment options
GET {{baseUrl}}/api/paymentoptions
Accept: application/json

### 7. Place order with DPD Standard + Credit Card
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-User-Id: {{userId}}

{
    "deliveryOptionId": "00000000-0000-0000-0001-000000000001",
    "paymentOptionId": "00000000-0000-0000-0002-000000000001",
    "shippingAddress": {
        "street": "456 Oak Avenue",
        "city": "Los Angeles",
        "postalCode": "90001",
        "country": "USA"
    }
}

### 8. Verify order was placed
GET {{baseUrl}}/api/orders
Accept: application/json
X-User-Id: {{userId}}

### 9. Verify cart is now empty
GET {{baseUrl}}/api/cart
Accept: application/json
X-User-Id: {{userId}}


###############################################################################
# ASYNC ORDER-PAID DEMOS
###############################################################################

@asyncDemoUserId = workshop-user-001

### Async Fan-Out Happy Path - add item to cart
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{asyncDemoUserId}}

{
    "itemId": "00000000-0000-0000-0000-000000000001",
    "quantity": 1
}

### Async Fan-Out Happy Path - place order
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-User-Id: {{asyncDemoUserId}}
X-Payment-Scenario: Success

{
    "deliveryOptionId": "00000000-0000-0000-0001-000000000001",
    "paymentOptionId": "00000000-0000-0000-0002-000000000001",
    "shippingAddress": {
        "street": "100 Trace Avenue",
        "city": "Seattle",
        "postalCode": "98101",
        "country": "USA"
    }
}

@channelPreferenceUserId = demo-user-002

### Async Fan-Out Channel Preference Demo - add item to cart
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-User-Id: {{channelPreferenceUserId}}

{
    "itemId": "00000000-0000-0000-0000-000000000002",
    "quantity": 1
}

### Async Fan-Out Channel Preference Demo - place order
# Seeded demo-user-002 has email enabled and SMS disabled in NotificationsApi.
POST {{baseUrl}}/api/orders
Content-Type: application/json
X-User-Id: {{channelPreferenceUserId}}
X-Payment-Scenario: Success

{
    "deliveryOptionId": "00000000-0000-0000-0001-000000000001",
    "paymentOptionId": "00000000-0000-0000-0002-000000000001",
    "shippingAddress": {
        "street": "200 Preference Street",
        "city": "Chicago",
        "postalCode": "60601",
        "country": "USA"
    }
}

