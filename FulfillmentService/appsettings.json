{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=ecommerce;Username=serilog;Password=serilog123"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "FulfillmentService"
    },
    "WriteTo": {
      "ConsoleSink": "Console",
      "LokiSink": {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4318/v1/logs",
          "protocol": "HttpProtobuf",
          "resourceAttributes": {
            "service.name": "fulfillment-service",
            "deployment.environment": "Development"
          }
        }
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "fulfillment-service",
    "Protocol": "http/protobuf",
    "OtlpEndpoint": "http://localhost:4318",
    "ResourceAttributes": {
      "service.namespace": "serilogdemo",
      "deployment.environment": "Development"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "PublishEnabled": true,
    "PublishIntervalSeconds": 3
  },
  "Fulfillment": {
    "WarehouseName": "demo-warehouse-01",
    "ProcessingDelayMilliseconds": 350
  }
}